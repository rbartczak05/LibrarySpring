### Zmienne globalne
@user_url = http://localhost:8081
@library_url = http://localhost:8080

### 1. REJESTRACJA (UserService)
POST {{user_url}}/auth/register
Content-Type: application/json

{
  "login": "tester_nowy",
  "password": "Password123!",
  "email": "tester@example.com",
  "firstName": "Tester",
  "lastName": "Projektu",
  "age": 30,
  "accessLevel": "READER"
}

### 2. LOGOWANIE (UserService)
POST {{user_url}}/auth/login
Content-Type: application/json

{
  "login": "tester_nowy",
  "password": "Password123!"
}

> {%
    client.global.set("auth_token", response.body.token);

    // Dekodowanie UUID z sub (subject) w JWT
    var base64Url = response.body.token.split('.')[1];
    var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
    var decoded = JSON.parse(atob(base64));
    client.global.set("user_uuid", decoded.sub);
%}

### 3. SYNCHRONIZACJA (LibraryService)
POST {{library_url}}/clients
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "id": "{{user_uuid}}",
  "firstName": "Tester",
  "lastName": "Projektu",
  "email": "tester@example.com",
  "age": 30,
  "active": true
}

### 4. DODANIE KSIĄŻKI (LibraryService)
POST {{library_url}}/book_set
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "title": "Wiedźmin: Miecz Przeznaczenia",
  "author": "Andrzej Sapkowski",
  "releaseYear": 1992,
  "quantity": 5
}

> {%
    if (response.status === 201) {
        client.global.set("new_book_id", response.body.id);
    } else {
        client.log("BŁĄD DODAWANIA KSIĄŻKI: " + JSON.stringify(response.body));
    }
%}

### 5. WYPOŻYCZENIE (LibraryService)
POST {{library_url}}/loans/me?bookSetId={{new_book_id}}
Authorization: Bearer {{auth_token}}

> {%
    if (response.status === 201) {
        client.global.set("loan_id", response.body.id);
    }
%}

### 6. MOJE WYPOŻYCZENIA (LibraryService)
GET {{library_url}}/loans/me
Authorization: Bearer {{auth_token}}